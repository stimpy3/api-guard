# Template. Copy to .env and fill in real values:
#
#   cp .env.example .env
#
# .env is gitignored. .env.example is committed and must never contain a real
# key — it exists so somebody cloning the repo knows what they need to supply.

# Groq API key, from https://console.groq.com/keys
# Used only by the AI layer (`api-guard check --explain`). The gate itself runs
# without it: if this is unset the explanation is skipped and the build result
# is identical.
GROQ_API_KEY=

# Model to use. This lives in config rather than source because Groq retires
# models on a real schedule and a hardcoded id turns into a 404 months later:
#   llama3-70b-8192          - gone, still pinned by most tutorials
#   llama-3.3-70b-versatile  - announced 2026-06-17, decommissioned 2026-08-16
# Check https://console.groq.com/docs/deprecations before changing this.
GROQ_MODEL=openai/gpt-oss-120b
